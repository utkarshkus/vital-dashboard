{
  "compilerOptions": {
    "target":           "ES2022",
    "module":           "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop":  true,
    "strict":           true,
    "skipLibCheck":     true,
    "resolveJsonModule": true,
    "allowJs":          true,
    "noEmit":           true,
    "types":            ["node"]
  },
  "include": ["netlify/functions/**/*", "scripts/**/*", "drizzle.config.ts"]
}
